# If set, /ws/agent and /ws/runtime require ?token=<value> on the connection URL.
# The client sends it via VITE_AGENT_TOKEN in apps/client/.env.
AGENT_TOKEN=

# Optional. If unset, persistence is skipped (agent still works, nothing is saved).
# Example: postgres://user:pass@localhost:5432/vibecode
DATABASE_URL=

# Set at least one of these. Providers without a key show up disabled in the UI.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
COHERE_API_KEY=
PERPLEXITY_API_KEY=
TOGETHER_AI_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
