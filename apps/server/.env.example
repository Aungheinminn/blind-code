# Client origin allowed for CORS + credentialed requests.
CLIENT_ORIGIN=http://localhost:5173

# Required for auth (users/sessions live here). If unset, /auth/* returns 503.
# Example: postgres://user:pass@localhost:5432/vibecode
DATABASE_URL=

# Required. 32 bytes, base64. Encrypts secrets at rest in users.integrations
# and projects.integrations. Generate with:  openssl rand -base64 32
ENCRYPTION_KEY=

# ----- Provider keys (platform fallback) -----
# Each user can set their own key in Settings → Providers. These env values
# are the fallback used when a user hasn't configured their own.
# Set at least one; providers without a key show as disabled in the UI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# ----- Supabase platform fallback -----
# A Personal Access Token for Blind Code's Supabase org. When a user hasn't
# connected their own Supabase account in Settings → Supabase, the agent uses
# this PAT to auto-provision per-user projects under Blind Code's org.
# Create at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# ----- Vercel platform fallback -----
# An API token for Blind Code's Vercel account. When a user hasn't connected
# their own token in Settings → Vercel, deploys target this account.
# Create at: https://vercel.com/account/settings/tokens
VERCEL_API_TOKEN=
# Optional. If set, platform-token Vercel calls scope to this team. User-token
# calls always ignore this and hit the user's own scope.
VERCEL_TEAM_ID=

# ----- Non-provider API keys (currently unused by the agent) -----
MISTRAL_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
COHERE_API_KEY=
PERPLEXITY_API_KEY=
TOGETHER_AI_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
