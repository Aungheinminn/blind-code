{
  "name": "vibe-coding-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.1.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter ./apps/web dev & bun run --filter ./apps/server dev",
    "dev:web": "bun run --filter ./apps/web dev",
    "dev:server": "bun run --filter ./apps/server dev",
    "build": "bun run --filter ./apps/web build",
    "lint": "bun run --filter ./apps/web lint",
    "typecheck": "bun run --filter ./apps/server typecheck"
  }
}
