# =====================================================================
# All variables below are REQUIRED. The platform's defaults must always
# be available; users layer their own keys on top in Settings. The server
# refuses to start if any of these is missing (see services/envCheck.ts).
# =====================================================================

# Client origin allowed for CORS + credentialed requests.
CLIENT_ORIGIN=http://localhost:5173

# Postgres connection. Users, sessions, and encrypted user keys live here.
DATABASE_URL=postgres://user:pass@localhost:5432/vibecode

# 32 bytes, base64. Encrypts user keys at rest in users.integrations.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# ----- Provider keys (platform defaults) -----
# Every signed-in user can use these out of the box. Settings → Providers
# lets a user override any of them with their own key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# ----- Supabase platform PAT -----
# Blind Code's org PAT. When a user hasn't connected their own Supabase
# account, the agent auto-provisions per-user projects under this org.
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# ----- Vercel platform token -----
# Blind Code's account token. When a user hasn't connected their own
# token, deploys target this account.
# https://vercel.com/account/settings/tokens
VERCEL_API_TOKEN=

# =====================================================================
# Optional
# =====================================================================

# If set, platform-token Vercel calls scope to this team. User-token calls
# always ignore this and hit the user's own scope.
VERCEL_TEAM_ID=

# Non-provider API keys (currently unused by the agent; placeholders).
MISTRAL_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
COHERE_API_KEY=
PERPLEXITY_API_KEY=
TOGETHER_AI_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
